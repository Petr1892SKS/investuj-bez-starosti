# Proměnné prostředí pro /api/contact
#
# Tenhle soubor je jen vzor — skutečné hodnoty patří do nastavení projektu
# na Vercelu (Settings → Environment Variables), nikdy do repozitáře.

# --- Google Sheets (servisní účet s právem Editor na tabulku) ---
# Když GOOGLE_CLIENT_EMAIL chybí, sáhne kód po staršímu
# GOOGLE_SERVICE_ACCOUNT_EMAIL, který už v projektu je.
GOOGLE_CLIENT_EMAIL=investuj-crm@analog-sum-493510-q4.iam.gserviceaccount.com

# Privátní klíč ze staženého JSON souboru servisního účtu.
# V JSON jsou konce řádků zapsané jako \n — vložte hodnotu i s nimi,
# kód si je převede na skutečné konce řádků sám.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Povinné a bez zálohy. Starší GOOGLE_SHEET_ID se schválně nepoužívá —
# může mířit na jinou tabulku a tichý zápis jinam je horší než pád.
SHEET_ID=1dZFGwaFM6NvMlFLKXu5LNeqfn_BsimwzQbYBgGacGoc
SHEET_TAB=Web formulář

# --- Brevo (kontakt se zakládá do listu 11) ---
BREVO_API_KEY=

# --- Přechod z Make ---
# Dokud je scénář v Make živý, posílá se lead oběma cestami (záměrná kontrola).
# Nastavením na "false" volání Make ustane a zůstane jen zápis do sheetu.
LEAD_SINK_MAKE=true

# --- Meta Conversions API ---
META_CAPI_TOKEN=
